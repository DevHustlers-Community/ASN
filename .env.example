# Copy to .env for local development. Never commit real credentials.

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
ASN_ENV=development
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Local PostgreSQL (compose.yaml)
# ---------------------------------------------------------------------------
POSTGRES_PORT=5432
# Superuser password. Used only by the local container and admin commands.
POSTGRES_PASSWORD=change_me
# Password assigned to the local asn_social/asn_chat/asn_moderation/asn_broker roles.
ASN_DB_PASSWORD=change_me

# ---------------------------------------------------------------------------
# Databases (one per owning service; separate roles, no cross-database grants)
# ---------------------------------------------------------------------------
SOCIAL_DATABASE_URL=postgres://asn_social:change_me@localhost:5432/social_db
CHAT_DATABASE_URL=postgres://asn_chat:change_me@localhost:5432/chat_db
MODERATION_DATABASE_URL=postgres://asn_moderation:change_me@localhost:5432/moderation_db
BROKER_DATABASE_URL=postgres://asn_broker:change_me@localhost:5432/broker_db
CHAT_TEST_DATABASE_URL=postgres://asn_chat:change_me@localhost:5432/chat_db_test
BROKER_TEST_DATABASE_URL=postgres://asn_broker:change_me@localhost:5432/broker_db_test

# ---------------------------------------------------------------------------
# Service ports (local)
# ---------------------------------------------------------------------------
SOCIAL_API_PORT=4001
CHAT_SERVICE_PORT=4002
MODERATION_API_PORT=4003
EVENT_BROKER_PORT=4004
WEB_PORT=3000
ADMIN_PORT=3001

# ---------------------------------------------------------------------------
# Event broker
# ---------------------------------------------------------------------------
BROKER_BASE_URL=http://localhost:4004
BROKER_SERVICE_ID=social-api
BROKER_SERVICE_TOKEN=change_me
BROKER_ADMIN_TOKEN=change_me
BROKER_PUBLISH_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Client-facing API
# ---------------------------------------------------------------------------
WEB_API_BASE_URL=http://localhost/api/v1
WEB_WS_BASE_URL=ws://localhost/socket
MOBILE_API_BASE_URL=http://localhost:8080/api/v1

# ---------------------------------------------------------------------------
# Identity provider
# ---------------------------------------------------------------------------
AUTH0_DOMAIN=example.eu.auth0.com
AUTH0_AUDIENCE=https://api.asn.local
AUTH0_STAFF_DOMAIN=staff.example.eu.auth0.com
# Secrets are injected by the deployment environment, never stored here.

# ---------------------------------------------------------------------------
# Object storage (S3-compatible / Cloudflare R2)
# ---------------------------------------------------------------------------
S3_ENDPOINT=https://example.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET_PUB=asn-public
S3_BUCKET_PRIV=asn-private
S3_BUCKET_EVIDENCE=asn-evidence
S3_ACCESS_KEY_ID=change_me
S3_SECRET_ACCESS_KEY=change_me

# ---------------------------------------------------------------------------
# Elixir release
# ---------------------------------------------------------------------------
SECRET_KEY_BASE=change_me_generate_with_mix_phx_gen_secret
PHX_HOST=localhost

# ---------------------------------------------------------------------------
# Mobile build-time config (public values only)
# ---------------------------------------------------------------------------
EXPO_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
EXPO_PUBLIC_WS_BASE_URL=ws://localhost:8080/socket

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

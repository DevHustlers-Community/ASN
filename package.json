{
  "name": "asn-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Arabian Social Network (ASN) Monorepo",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '@asn/web' dev",
    "dev:web": "bun run --filter '@asn/web' dev",
    "build": "bun run --filter '@asn/web' build",
    "build:web": "bun run --filter '@asn/web' build",
    "typecheck": "bun run --filter '@asn/web' typecheck",
    "test": "bun run --filter '@asn/web' test"
  },
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
